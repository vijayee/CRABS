{
  "name": "crabs-wasm",
  "version": "0.1.0",
  "description": "WebAssembly bindings for the CRABS cryptographic attribute-based state machine library — runs in any browser, Node.js, edge worker, or standalone WASM runtime",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./dev": {
      "types": "./dev.d.ts",
      "default": "./dev.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "cd ../.. && OPENSSL_SRC=/tmp/openssl-3.4.0 bash build_wasm.sh",
    "test": "node test/smoke.js && node test/change-events.js && node test/devtools.js && node test/schedules.js"
  },
  "files": [
    "crabs.wasm",
    "crabs.js",
    "crabs.dev.wasm",
    "crabs.dev.js",
    "index.js",
    "bindings-core.js",
    "dev.js",
    "index.d.ts",
    "dev.d.ts",
    "README.md"
  ],
  "keywords": [
    "crabs",
    "wasm",
    "webassembly",
    "abe",
    "attribute-based-encryption",
    "crdt",
    "ot",
    "cryptographic",
    "browser",
    "isomorphic"
  ],
  "license": "MIT"
}